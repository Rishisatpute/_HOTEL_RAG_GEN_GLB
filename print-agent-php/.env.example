# Copy this file to .env and fill in real values before running the agent.
# This runs ON A COMPUTER INSIDE THE RESTAURANT, on the same network as the
# printers — it is the only thing that can reach their private 192.168.x.x
# addresses, which is why it can't just be part of the web-hosted backend.

# The deployed backend URL (same one orders.js on the website points to)
BACKEND_URL=https://your-php-backend-url

# Local IP address of each printer, found via the printer's self-test page
# or its LCD/network menu. Leave blank for any station you don't have a
# printer for yet — jobs for it will just be skipped (logged, not lost).
KITCHEN_PRINTER_IP=192.168.1.201
BAR_PRINTER_IP=192.168.1.202
BILLING_PRINTER_IP=192.168.1.203

# Standard ESC/POS network-printer port. Almost never needs changing.
PRINTER_PORT=9100

# How often to check for new print jobs (seconds). Lower = more responsive,
# slightly more load on the server. 4 is a good default for one restaurant.
POLL_SECONDS=4

# Set to true to print every ticket to this terminal window instead of a
# real printer — useful for testing the whole order -> ticket pipeline
# before any printer is physically wired up.
DRY_RUN=false
