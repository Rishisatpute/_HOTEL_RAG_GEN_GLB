# Copy this file to config/.env and fill in your real MySQL credentials.
# Never commit a real .env file — it's already in .gitignore.
#
# On MilesWeb (cPanel): cPanel -> MySQL Databases -> create a database and
# a user, add the user to the database with ALL PRIVILEGES. The host is
# almost always "localhost" since the PHP app and MySQL run on the same
# server here (that's the whole point of this setup — no remote-MySQL
# headaches).

DB_HOST=localhost
DB_NAME=cpaneluser_angaardhaba
DB_USER=cpaneluser_angaardhaba
DB_PASSWORD=

# Comma-separated list of origins allowed to call this API.
# Your Vercel frontend URL, plus http://localhost:5000 if testing locally.
ALLOWED_ORIGINS=https://hotel-rag-gen-glb.vercel.app,http://localhost:5000

# Shared passcode gating staff.html/waiter.html/table-qr.html/counter.html —
# checked by staff_login.php, never shipped in frontend source. Change this
# to your own value before deploying for real.
STAFF_PIN=change-me

# Secret query-string token that unlocks the staff hub without typing the PIN.
# Bookmark https://<frontend-domain>/staff.html?token=THIS_VALUE and hand that
# link only to staff — checked by staff_login.php the same way STAFF_PIN is.
# Change this before deploying for real.
STAFF_ACCESS_TOKEN=change-me-too
