# Copy this file to .env for local development, or set these as
# environment variables in your hosting platform's dashboard (Render, etc).
# Never commit a real .env file — it's already in .gitignore.

# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/angaar-dhaba?retryWrites=true&w=majority

# Port the server listens on (Render sets this automatically in production)
PORT=5000

# Comma-separated list of origins allowed to call this API
# (your Vercel deployment URL, plus localhost for local testing)
ALLOWED_ORIGINS=https://hotel-rag-gen-glb.vercel.app,http://localhost:5000
